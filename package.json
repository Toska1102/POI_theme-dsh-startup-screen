{
  "name": "poi-theme-dsh-startup-screen",
  "version": "2.1.1",
  "description": "POI / The Machine 冷白启动动画：十阶段连续演出、一次确认、约 9 秒时长和可配置音效。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-desktop",
    "startup",
    "splash",
    "boot-animation"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Toska1102/POI_theme-dsh-startup-screen.git"
  },
  "bugs": {
    "url": "https://github.com/Toska1102/POI_theme-dsh-startup-screen/issues"
  },
  "homepage": "https://github.com/Toska1102/POI_theme-dsh-startup-screen#readme",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "author": "沈宏宏"
}
