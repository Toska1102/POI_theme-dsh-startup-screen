          "x": 113.77777777777777,
          "y": 599.4418604651163,
          "name": "可调正文 3",
          "fill": "#AEBBBD",
          "textGrowth": "fixed-width",
          "width": 1040,
          "content": "开机日志、状态条、按钮与问候文案可调整。标题字形参考所给图片，当前用 Michroma 近似；字号与字距可调整。监控标号保留 VT323，数据保留 Share Tech Mono。",
          "lineHeight": 1.5,
          "fontFamily": "Jost",
          "fontSize": 15.627906976744185,
          "fontWeight": "normal"
        },
