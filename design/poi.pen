          "x": 160.08268733850127,
          "y": 305.86046511627904,
          "name": "可调标题 1",
          "fill": "#F2E02A",
          "content": "01  底片 / VIDEO",
          "fontFamily": "Jost",
          "fontSize": 18.97674418604651,
          "fontWeight": "bold"
        },
        {
          "type": "text",
          "id": "ag7WP",
          "x": 113.77777777777777,
          "y": 340.4651162790698,
          "name": "可调正文 1",
          "fill": "#AEBBBD",
          "textGrowth": "fixed-width",
          "width": 1040,
          "content": "替换镜头 A（接入航拍）、镜头 B（雨夜人物）、镜头 C（暗廊背影）和镜头 D（欢迎页俯瞰城市）。接受本地 MP4 或静帧；画布中的四张底片由生成工具制作。",
          "lineHeight": 1.5,
          "fontFamily": "Jost",
          "fontSize": 15.627906976744185,
          "fontWeight": "normal"
        },
        {
          "type": "rectangle",
